folder('{{FOLDER}}') {

    displayName('{{FOLDER}}')

    description('Automatically created project folder')

}


pipelineJob('{{FOLDER}}/{{NAME}}') {


    description(
        'Generated automatically by DevOps Platform'
    )


    definition {


        cpsScm {


            scm {


                git {


                    remote {


                        url('{{APP_REPO}}')


                        credentials('{{CREDENTIALS}}')


                    }


                    branch('{{BRANCH}}')


                }


            }


            scriptPath('generated/{{NAME}}/Jenkinsfile')


        }


    }


}